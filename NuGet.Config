<?xml version="1.0" encoding="utf-8"?>
<!--
  Scoped to this repo: restores only from nuget.org, ignoring any machine-wide
  private feeds (some of which may be unreachable outside their network) so the
  demo builds reproducibly for anyone who clones it.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
